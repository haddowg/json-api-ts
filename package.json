{
  "name": "json-api-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A typesafe, JSON:API-flavored TypeScript client generated from the haddowg/json-api-symfony OpenAPI spec.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "pnpm generate",
    "build": "turbo run build",
    "pretest": "pnpm generate",
    "test": "vitest run",
    "pretypecheck": "pnpm generate",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint:publish": "turbo run lint:publish",
    "smoke": "pnpm --filter @haddowg/json-api-smoke run smoke",
    "generate": "turbo run build --filter=@haddowg/json-api-codegen --filter=@haddowg/json-api-mcp --output-logs=errors-only && node scripts/generate.mjs",
    "codegen:check": "node scripts/generate.mjs --check",
    "check:pins": "node scripts/check-pins.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@haddowg/json-api-symfony-specs": "2.1.1",
    "@haddowg/json-api-witness": "2.4.0",
    "@types/node": "^22.10.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.0.0",
    "publint": "^0.3.0",
    "tsdown": "^0.22.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.9": "^3.1.9"
    }
  }
}
