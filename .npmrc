# The server documents this repo generates from (@haddowg/json-api-witness and
# @haddowg/json-api-symfony-specs) are published to GitHub Packages, which needs a token with
# read:packages even to install. The packages this repo publishes go to npmjs: each names it in
# publishConfig.registry, and since pnpm prefers this scope mapping, the release workflow also
# publishes with --@haddowg:registry=https://registry.npmjs.org/.
@haddowg:registry=https://npm.pkg.github.com
# GitHub Packages serves tarballs from its own download URLs, which pnpm cannot derive.
lockfile-include-tarball-url=true
