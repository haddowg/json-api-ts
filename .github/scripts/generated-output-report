#!/usr/bin/env bash
# Compares a pull request's generated output against its base's, keeps one comment on the
# pull request reporting the difference, and fails until someone adds the
# `generated-output` label to say they read it. A later push that changes the difference
# removes the label, so an acknowledgement never covers output nobody has seen.
#
# Usage: generated-output-report <base-dir> <head-dir>
# Needs GH_TOKEN, GITHUB_REPOSITORY, GITHUB_EVENT_PATH and GITHUB_STEP_SUMMARY.
set -uo pipefail

base="$1"
head="$2"
label="generated-output"
marker="<!-- generated-output-report -->"
pr="$(jq -r .pull_request.number "${GITHUB_EVENT_PATH}")"
action="$(jq -r .action "${GITHUB_EVENT_PATH}")"
labelled="$(jq -r --arg label "${label}" '[.pull_request.labels[].name] | index($label) != null' "${GITHUB_EVENT_PATH}")"

patch="${RUNNER_TEMP:-/tmp}/generated-output.patch"
diff -ruN "${base}" "${head}" > "${patch}"
body="${RUNNER_TEMP:-/tmp}/generated-output.md"

if [ ! -s "${patch}" ]; then
  printf '%s\n%s\n' "${marker}" 'The generated output is unchanged by this pull request.' > "${body}"
  .github/scripts/upsert-comment "${pr}" "${marker}" "${body}" || echo "Could not comment."
  echo "The generated output is unchanged." >> "${GITHUB_STEP_SUMMARY}"
  exit 0
fi

# The diff's file headers carry paths and timestamps that differ on every run; hash the
# changes alone, so an unchanged output keeps its acknowledgement.
hash="$(grep -v -E '^(diff |--- |\+\+\+ )' "${patch}" | sha256sum | cut -c1-16)"
previous="$(gh api "repos/${GITHUB_REPOSITORY}/issues/${pr}/comments" --paginate \
  --jq ".[] | select(.body | contains(\"${marker}\")) | .body" 2> /dev/null \
  | grep -o 'generated-output-hash: [0-9a-f]*' | head -n 1 | cut -d' ' -f2)"

stat="$(git diff --no-index --stat=100 "${base}" "${head}" | tail -n 40)"
lines="$(wc -l < "${patch}")"
{
  echo "${marker}"
  echo "<!-- generated-output-hash: ${hash} -->"
  echo "This pull request changes the generated output (${lines} diff lines):"
  echo
  echo '```'
  echo "${stat}"
  echo '```'
  echo
  echo '<details><summary>The first 400 lines of the diff</summary>'
  echo
  echo '```diff'
  head -n 400 "${patch}"
  echo '```'
  echo '</details>'
  echo
  echo "Read it, then add the \`${label}\` label to acknowledge it. A push that changes the diff removes the label again."
} > "${body}"
cat "${body}" >> "${GITHUB_STEP_SUMMARY}"
.github/scripts/upsert-comment "${pr}" "${marker}" "${body}" || echo "Could not comment."

if [ "${labelled}" = "true" ] && [ "${action}" = "synchronize" ] && [ -n "${previous}" ] && [ "${previous}" != "${hash}" ]; then
  gh api -X DELETE "repos/${GITHUB_REPOSITORY}/issues/${pr}/labels/${label}" > /dev/null 2>&1 || true
  echo "::error::The generated output changed since it was acknowledged. Read the new diff and add the '${label}' label again."
  exit 1
fi

if [ "${labelled}" != "true" ]; then
  echo "::error::This pull request changes the generated output. Read the diff in the pull request comment, then add the '${label}' label."
  exit 1
fi

echo "The generated output change is acknowledged."
