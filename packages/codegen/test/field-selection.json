  "fields": {
    "name": "fields[articles]",
    "in": "query",
    "description": "A comma-separated list of `articles` fields to return (sparse fieldsets). Select single keys of `scores`, `totals` or `location` as `<attribute>.<key>` under the [Field Selection profile](https://haddowg.github.io/json-api/profiles/field-selection/); listing the attribute itself selects all of it. Select keys of every item of `lines` as `<attribute>.*.<key>`; the list keeps its length and order. A key of a nested object is selected as `<attribute>.<key>.<key>`, and listing the key itself selects all of it.",
    "schema": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "title",
              "slug",
              "status",
              "priority",
              "wordCount",
              "rating",
              "featured",
              "releasedOn",
              "publishedAt",
              "syncedAt",
              "archivedAt",
              "embargoLifts",
              "editorEmail",
              "canonicalUrl",
              "excerpt",
              "revision",
              "reviewNote",
              "originIp",
              "keywords",
              "priorities",
              "analytics",
              "address",
              "block",
              "shape",
              "contact",
              "createdAt",
              "legacyRef",
              "commentCount",
              "authorName",
              "score",
              "sources",
              "steps",
              "subtitle",
              "labels",
              "rows",
              "metrics",
              "scores",
              "totals",
              "location",
              "lines",
              "value",
              "threshold",
              "level",
              "defaultValue",
              "fallbackValue",
              "reviewedBy",
              "approvedBy",
              "aliases",
              "formerAliases",
              "placement",
              "author",
              "tags",
              "publisher",
              "cover",
              "locked",
              "attachments",
              "editor",
              "sponsors",
              "subject",
              "gallery",
              "formerAuthor",
              "contributors"
            ]
          },
          {
            "type": "string",
            "pattern": "^scores\\.(?:[a-z][a-z0-9_]*)$"
          },
          {
            "type": "string",
            "pattern": "^totals\\.[^.,*]+$"
          },
          {
            "type": "string",
            "pattern": "^location\\.(?:[a-z]+)$"
          },
          {
            "type": "string",
            "pattern": "^location\\.geo\\.(?:lat|lng)$"
          },
          {
            "type": "string",
            "pattern": "^lines\\.\\*$"
          },
          {
            "type": "string",
            "pattern": "^lines\\.\\*\\.(?:sku|quantity|price)$"
          },
          {
            "type": "string",
            "pattern": "^lines\\.\\*\\.price\\.(?:amount|currency)$"
          }
        ]
      }
    },
    "style": "form",
    "explode": false
  }
