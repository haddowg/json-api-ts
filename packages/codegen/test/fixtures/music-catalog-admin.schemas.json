{
    "albums": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:albums",
        "type": "object",
        "description": "An `albums` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "albums"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                    },
                    "averageRating": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "artwork": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "releasedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "Value must be before a dynamically-resolved date/time bound."
                    },
                    "explicit": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    },
                    "status": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Where the album sits in its release lifecycle.\n\n| Value | Description |\n| --- | --- |\n| `upcoming` | Announced but not yet on sale. |\n| `released` | Released and available to stream or buy. |\n| `withdrawn` | Withdrawn from the catalogue (back-catalogue or rights lapsed). |",
                        "enum": [
                            "upcoming",
                            "released",
                            "withdrawn",
                            null
                        ],
                        "x-enum-varnames": [
                            "Upcoming",
                            "Released",
                            "Withdrawn"
                        ],
                        "x-enum-descriptions": [
                            "Announced but not yet on sale.",
                            "Released and available to stream or buy.",
                            "Withdrawn from the catalogue (back-catalogue or rights lapsed)."
                        ]
                    },
                    "availableFrom": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    },
                    "availableUntil": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "Value is compared against the `availableFrom` field (>)."
                    },
                    "releaseInfo": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "label": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "catalogueNumber": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    }
                },
                "required": [
                    "title",
                    "averageRating",
                    "artwork",
                    "releasedAt",
                    "explicit",
                    "status",
                    "availableFrom",
                    "availableUntil",
                    "releaseInfo"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "artists": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:artists",
        "type": "object",
        "description": "An `artists` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "artists"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                    },
                    "slug": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "website": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uri"
                    },
                    "bio": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000
                    },
                    "trackCount": {
                        "type": "integer"
                    },
                    "createdAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "name",
                    "slug",
                    "website",
                    "bio",
                    "trackCount",
                    "createdAt"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "libraries": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:libraries",
        "type": "object",
        "description": "An `libraries` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "libraries"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object"
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "playlists": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:playlists",
        "type": "object",
        "description": "An `playlists` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "playlists"
            },
            "id": {
                "type": "string",
                "format": "uuid"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1
                    },
                    "slug": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "example": "example-slug"
                    },
                    "public": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    },
                    "externalId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid"
                    }
                },
                "required": [
                    "title",
                    "slug",
                    "public",
                    "externalId"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "public-profiles": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:public-profiles",
        "type": "object",
        "description": "An `public-profiles` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "public-profiles"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "displayName": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "displayName"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "tracks": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:tracks",
        "type": "object",
        "description": "An `tracks` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "tracks"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1
                    },
                    "trackNumber": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "minimum": 1
                    },
                    "durationSeconds": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "explicit": {
                        "type": [
                            "boolean",
                            "null"
                        ]
                    },
                    "genres": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "previewOffset": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "A date/time value written as `09:08:07`. No standard `format` keyword describes that shape, so parse it literally rather than as an RFC 3339 date-time."
                    },
                    "displayTitle": {
                        "type": "string"
                    }
                },
                "required": [
                    "title",
                    "trackNumber",
                    "durationSeconds",
                    "explicit",
                    "genres",
                    "previewOffset",
                    "displayTitle"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "users": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:users",
        "type": "object",
        "description": "An `users` resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "users"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    },
                    "displayName": {
                        "type": "string",
                        "minLength": 1
                    },
                    "birthDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date"
                    },
                    "preferences": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "minProperties": 0,
                        "maxProperties": 20,
                        "additionalProperties": {}
                    },
                    "lastSeenIp": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                },
                "required": [
                    "email",
                    "displayName",
                    "birthDate",
                    "preferences",
                    "lastSeenIp"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    }
}
