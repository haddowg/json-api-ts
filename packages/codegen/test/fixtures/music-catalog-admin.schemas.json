{
    "albums": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:albums",
        "type": "object",
        "description": "An album resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "albums"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "example": "Abbey Road"
                    },
                    "averageRating": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "example": 4.5
                    },
                    "artwork": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "/uploads/artwork/1.png"
                    },
                    "releasedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "Value must be before a dynamically-resolved date/time bound.",
                        "example": "1969-09-26T00:00:00+00:00"
                    },
                    "explicit": {
                        "type": "boolean",
                        "example": false
                    },
                    "status": {
                        "type": "string",
                        "description": "Where the album sits in its release lifecycle.\n\n| Value | Description |\n| --- | --- |\n| `upcoming` | Announced but not yet on sale. |\n| `released` | Released and available to stream or buy. |\n| `withdrawn` | Withdrawn from the catalogue (back-catalogue or rights lapsed). |",
                        "enum": [
                            "upcoming",
                            "released",
                            "withdrawn"
                        ],
                        "example": "released",
                        "x-enum-varnames": [
                            "Upcoming",
                            "Released",
                            "Withdrawn"
                        ],
                        "x-enum-descriptions": [
                            "Announced but not yet on sale.",
                            "Released and available to stream or buy.",
                            "Withdrawn from the catalogue (back-catalogue or rights lapsed)."
                        ]
                    },
                    "availableFrom": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "example": "2024-01-01"
                    },
                    "availableUntil": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "Value is compared against the `availableFrom` field (>).",
                        "example": "2026-12-31"
                    },
                    "releaseInfo": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "label": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "example": "Apple Records"
                            },
                            "catalogueNumber": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "example": "PCS 7088"
                            }
                        },
                        "example": {
                            "label": "Apple Records",
                            "catalogueNumber": "PCS 7088"
                        }
                    }
                },
                "required": [
                    "title",
                    "averageRating",
                    "artwork",
                    "releasedAt",
                    "explicit",
                    "status",
                    "availableFrom",
                    "availableUntil",
                    "releaseInfo"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "artists": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:artists",
        "type": "object",
        "description": "An artist resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "artists"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "example": "The Beatles"
                    },
                    "slug": {
                        "type": "string",
                        "minLength": 1,
                        "example": "the-beatles"
                    },
                    "website": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uri",
                        "example": "https://www.thebeatles.com"
                    },
                    "bio": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "example": "Rock band formed in Liverpool in 1960."
                    },
                    "trackCount": {
                        "type": "integer",
                        "example": 17
                    },
                    "createdAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "example": "2024-03-01T12:00:00+00:00"
                    }
                },
                "required": [
                    "name",
                    "slug",
                    "website",
                    "bio",
                    "trackCount",
                    "createdAt"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "libraries": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:libraries",
        "type": "object",
        "description": "A library resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "libraries"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object"
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "playlists": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:playlists",
        "type": "object",
        "description": "A playlist resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "playlists"
            },
            "id": {
                "type": "string",
                "format": "uuid",
                "example": "0b9e3c34-2f4e-4c1a-9a57-6d3b2a1f8c10"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Road trip"
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "example": "example-slug"
                    },
                    "public": {
                        "type": "boolean",
                        "example": true
                    },
                    "externalId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid",
                        "example": "5f1d7c2e-8a4b-4e6f-9c3d-2b1a0e9f8d7c"
                    }
                },
                "required": [
                    "title",
                    "slug",
                    "public",
                    "externalId"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "public-profiles": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:public-profiles",
        "type": "object",
        "description": "A public profile resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "public-profiles"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "displayName": {
                        "type": "string",
                        "example": "Ada"
                    }
                },
                "required": [
                    "displayName"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "tracks": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:tracks",
        "type": "object",
        "description": "A track resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "tracks"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Come Together"
                    },
                    "trackNumber": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 1
                    },
                    "durationSeconds": {
                        "type": "integer",
                        "example": 259
                    },
                    "explicit": {
                        "type": "boolean",
                        "example": false
                    },
                    "genres": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "example": [
                            "rock"
                        ]
                    },
                    "previewOffset": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "A date/time value written as `09:08:07`. No standard `format` keyword describes that shape, so parse it literally rather than as an RFC 3339 date-time.",
                        "example": "00:00:30"
                    },
                    "displayTitle": {
                        "type": "string",
                        "example": "1. Come Together"
                    }
                },
                "required": [
                    "title",
                    "trackNumber",
                    "durationSeconds",
                    "explicit",
                    "genres",
                    "previewOffset",
                    "displayTitle"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "users": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:users",
        "type": "object",
        "description": "A user resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "users"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1,
                        "example": "ada@example.com"
                    },
                    "displayName": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Ada"
                    },
                    "birthDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "example": "1990-12-10"
                    },
                    "preferences": {
                        "type": "object",
                        "minProperties": 0,
                        "maxProperties": 20,
                        "additionalProperties": {},
                        "example": {
                            "theme": "dark"
                        }
                    },
                    "lastSeenIp": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "203.0.113.7"
                    }
                },
                "required": [
                    "email",
                    "displayName",
                    "birthDate",
                    "preferences",
                    "lastSeenIp"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    }
}
