    "releases": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:releases",
        "type": "object",
        "description": "A release resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "releases"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "catalogNumber": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "example": "PCS 7088"
                    },
                    "format": {
                        "oneOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "rpm": {
                                        "type": "integer",
                                        "minimum": 16,
                                        "maximum": 78,
                                        "example": 33
                                    },
                                    "coloured": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ],
                                        "example": false
                                    },
                                    "medium": {
                                        "type": "string",
                                        "const": "vinyl"
                                    }
                                },
                                "required": [
                                    "rpm",
                                    "coloured",
                                    "medium"
                                ]
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "discs": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "medium": {
                                        "type": "string",
                                        "const": "cd"
                                    }
                                },
                                "required": [
                                    "discs",
                                    "medium"
                                ]
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "codec": {
                                        "type": "string",
                                        "minLength": 1,
                                        "maxLength": 16
                                    },
                                    "bitrateKbps": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ],
                                        "minimum": 32
                                    },
                                    "medium": {
                                        "type": "string",
                                        "const": "digital"
                                    }
                                },
                                "required": [
                                    "codec",
                                    "bitrateKbps",
                                    "medium"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "discriminator": {
                            "propertyName": "medium"
                        }
                    },
                    "packaging": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "material": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 40,
                                "example": "card"
                            },
                            "gatefold": {
                                "type": [
                                    "boolean",
                                    "null"
                                ],
                                "example": true
                            }
                        },
                        "required": [
                            "material",
                            "gatefold"
                        ]
                    },
                    "availability": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": {},
                        "anyOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "worldwide": {
                                        "type": "boolean",
                                        "const": true
                                    }
                                },
                                "required": [
                                    "worldwide"
                                ]
                            },
                            {
                                "type": "object",
                                "properties": {
                                    "regions": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                },
                                "required": [
                                    "regions"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "example": {
                            "worldwide": true
                        }
                    },
                    "dimensions": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "additionalProperties": {},
                        "anyOf": [
                            {
                                "type": "null"
                            },
                            {
                                "allOf": [
                                    {
                                        "type": "object",
                                        "properties": {
                                            "widthMm": {
                                                "type": "number"
                                            },
                                            "heightMm": {
                                                "type": "number"
                                            }
                                        },
                                        "required": [
                                            "widthMm",
                                            "heightMm"
                                        ]
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "depthMm": {
                                                "type": "number"
                                            }
                                        }
                                    }
                                ]
                            }
                        ],
                        "example": {
                            "widthMm": 315,
                            "heightMm": 315,
                            "depthMm": 4
                        }
                    }
                },
                "required": [
                    "catalogNumber",
                    "format",
                    "packaging",
                    "availability",
                    "dimensions"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "tracks": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:tracks",
        "type": "object",
        "description": "A track resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "tracks"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Come Together"
                    },
                    "trackNumber": {
                        "type": "integer",
                        "minimum": 1,
                        "example": 1
                    },
                    "durationSeconds": {
                        "type": "integer",
                        "example": 259
                    },
                    "explicit": {
                        "type": "boolean",
                        "example": false
                    },
                    "genres": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "example": [
                            "rock"
                        ]
                    },
                    "previewOffset": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "A date/time value written as `09:08:07`. No standard `format` keyword describes that shape, so parse it literally rather than as an RFC 3339 date-time.",
                        "example": "00:00:30"
                    },
                    "displayTitle": {
                        "type": "string",
                        "example": "1. Come Together"
                    }
                },
                "required": [
                    "title",
                    "trackNumber",
                    "durationSeconds",
                    "explicit",
                    "genres",
                    "previewOffset",
                    "displayTitle"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
