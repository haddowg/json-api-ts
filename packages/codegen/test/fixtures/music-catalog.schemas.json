{
    "albums": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:albums",
        "type": "object",
        "description": "An album resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "albums"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "example": "Abbey Road"
                    },
                    "averageRating": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "example": 4.5
                    },
                    "artwork": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "example": "/uploads/artwork/1.png"
                    },
                    "releasedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "Value must be before a dynamically-resolved date/time bound.",
                        "example": "1969-09-26T00:00:00+00:00"
                    },
                    "explicit": {
                        "type": "boolean",
                        "example": false
                    },
                    "status": {
                        "type": "string",
                        "description": "Where the album sits in its release lifecycle.\n\n| Value | Description |\n| --- | --- |\n| `upcoming` | Announced but not yet on sale. |\n| `released` | Released and available to stream or buy. |\n| `withdrawn` | Withdrawn from the catalogue (back-catalogue or rights lapsed). |",
                        "enum": [
                            "upcoming",
                            "released",
                            "withdrawn"
                        ],
                        "example": "released",
                        "x-enum-varnames": [
                            "Upcoming",
                            "Released",
                            "Withdrawn"
                        ],
                        "x-enum-descriptions": [
                            "Announced but not yet on sale.",
                            "Released and available to stream or buy.",
                            "Withdrawn from the catalogue (back-catalogue or rights lapsed)."
                        ]
                    },
                    "availableFrom": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "example": "2024-01-01"
                    },
                    "availableUntil": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "Value is compared against the `availableFrom` field (>).",
                        "example": "2026-12-31"
                    },
                    "releaseInfo": {
                        "type": [
                            "object",
                            "null"
                        ],
                        "properties": {
                            "label": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "example": "Apple Records"
                            },
                            "catalogueNumber": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "example": "PCS 7088"
                            }
                        },
                        "example": {
                            "label": "Apple Records",
                            "catalogueNumber": "PCS 7088"
                        }
                    }
                },
                "required": [
                    "title",
                    "averageRating",
                    "artwork",
                    "releasedAt",
                    "explicit",
                    "status",
                    "availableFrom",
                    "availableUntil",
                    "releaseInfo"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
    "artists": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:artists",
        "type": "object",
        "description": "An artist resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "artists"
            },
            "id": {
                "type": "string",
                "example": "1"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120,
                        "example": "The Beatles"
                    },
                    "slug": {
                        "type": "string",
                        "minLength": 1,
                        "example": "the-beatles"
                    },
                    "website": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uri",
                        "example": "https://www.thebeatles.com"
                    },
                    "bio": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 1000,
                        "example": "Rock band formed in Liverpool in 1960."
                    },
                    "trackCount": {
                        "type": "integer",
                        "example": 17
                    },
                    "createdAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "example": "2024-03-01T12:00:00+00:00"
                    }
                },
                "required": [
                    "name",
                    "slug",
                    "website",
                    "bio",
                    "trackCount",
                    "createdAt"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
