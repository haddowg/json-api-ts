        "description": "A country resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "countries"
            },
            "id": {
                "type": "string"
            },
            "attributes": {
                "type": "object"
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    }
}
