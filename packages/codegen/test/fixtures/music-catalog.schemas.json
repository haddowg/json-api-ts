    "playlists": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "urn:jsonapi:schema:playlists",
        "type": "object",
        "description": "A playlist resource object.",
        "properties": {
            "type": {
                "type": "string",
                "const": "playlists"
            },
            "id": {
                "type": "string",
                "format": "uuid",
                "example": "0b9e3c34-2f4e-4c1a-9a57-6d3b2a1f8c10"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Road trip"
                    },
                    "slug": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "example": "example-slug"
                    },
                    "public": {
                        "type": "boolean",
                        "example": true
                    },
                    "externalId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "uuid",
                        "example": "5f1d7c2e-8a4b-4e6f-9c3d-2b1a0e9f8d7c"
                    }
                },
                "required": [
                    "title",
                    "slug",
                    "public",
                    "externalId"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
