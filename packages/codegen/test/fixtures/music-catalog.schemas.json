                "example": "01J9Z8K4QK3V6W2X9Y5T7R1M0N"
            },
            "attributes": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "example": "Living room speaker"
                    }
                },
                "required": [
                    "label"
                ]
            },
            "relationships": {
                "type": "object"
            },
            "links": {
                "type": "object"
            },
            "meta": {
                "type": "object"
            }
        },
        "required": [
            "type",
            "id"
        ]
    },
