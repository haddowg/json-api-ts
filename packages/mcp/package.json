{
  "name": "@haddowg/json-api-mcp",
  "version": "1.2.0",
  "description": "MCP tool definitions and a call handler for a JSON:API server, served from a model generated at build time from its OpenAPI document.",
  "license": "MIT",
  "author": "Gregory Haddow (https://github.com/haddowg)",
  "homepage": "https://haddowg.github.io/json-api-ts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haddowg/json-api-ts.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/haddowg/json-api-ts/issues",
  "keywords": [
    "json-api",
    "jsonapi",
    "typescript",
    "mcp",
    "model-context-protocol",
    "openapi",
    "llm",
    "tools"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./generate": {
      "import": {
        "types": "./dist/generate.d.mts",
        "default": "./dist/generate.mjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "json-api-mcp": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint --strict && attw --pack . --exclude-entrypoints ./generate"
  },
  "dependencies": {
    "@haddowg/json-api-client": "workspace:^"
  },
  "peerDependencies": {
    "@haddowg/json-api-codegen": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@haddowg/json-api-codegen": {
      "optional": true
    }
  },
  "devDependencies": {
    "@haddowg/json-api-codegen": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.0"
  }
}
