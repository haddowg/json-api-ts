{
  "name": "@haddowg/json-api-angular",
  "version": "1.4.0",
  "description": "Signal-based Angular bindings for the JSON:API client: an HttpClient transport, DI providers, resource/mutation helpers, and a TanStack Query entry point.",
  "license": "MIT",
  "author": "Gregory Haddow (https://github.com/haddowg)",
  "homepage": "https://haddowg.github.io/json-api-ts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haddowg/json-api-ts.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/haddowg/json-api-ts/issues",
  "keywords": [
    "json-api",
    "jsonapi",
    "typescript",
    "angular",
    "signals",
    "httpclient",
    "openapi"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./query": {
      "import": {
        "types": "./dist/query/index.d.mts",
        "default": "./dist/query/index.mjs"
      },
      "require": {
        "types": "./dist/query/index.d.cts",
        "default": "./dist/query/index.cjs"
      }
    },
    "./forms": {
      "import": {
        "types": "./dist/forms/index.d.mts",
        "default": "./dist/forms/index.mjs"
      },
      "require": {
        "types": "./dist/forms/index.d.cts",
        "default": "./dist/forms/index.cjs"
      }
    },
    "./forms/signals": {
      "import": {
        "types": "./dist/forms/signals/index.d.mts",
        "default": "./dist/forms/signals/index.mjs"
      },
      "require": {
        "types": "./dist/forms/signals/index.d.cts",
        "default": "./dist/forms/signals/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "query": [
        "./dist/query/index.d.cts"
      ],
      "forms": [
        "./dist/forms/index.d.cts"
      ],
      "forms/signals": [
        "./dist/forms/signals/index.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@haddowg/json-api-client": "workspace:^"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/forms": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@haddowg/json-api-query": "workspace:^",
    "@tanstack/angular-query": "^5.108.1"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    },
    "@haddowg/json-api-query": {
      "optional": true
    },
    "@tanstack/angular-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@haddowg/json-api-query": "workspace:^",
    "@ngx-formly/core": "~10.0.1",
    "@tanstack/angular-query": "^5.108.1",
    "jsdom": "^25.0.0",
    "rxjs": "^7.8.0"
  }
}
