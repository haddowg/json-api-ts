{
  "name": "@haddowg/json-api-angular",
  "version": "1.2.4",
  "description": "Signal-based Angular bindings for the JSON:API client: an HttpClient transport, DI providers, and resource/mutation helpers.",
  "license": "MIT",
  "author": "Gregory Haddow (https://github.com/haddowg)",
  "homepage": "https://haddowg.github.io/json-api-ts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haddowg/json-api-ts.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/haddowg/json-api-ts/issues",
  "keywords": [
    "json-api",
    "jsonapi",
    "typescript",
    "angular",
    "signals",
    "httpclient",
    "openapi"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@haddowg/json-api-client": "workspace:^"
  },
  "peerDependencies": {
    "@angular/common": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "jsdom": "^25.0.0",
    "rxjs": "^7.8.0"
  }
}
